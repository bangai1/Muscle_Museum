@model Create_Ticket_ViewModel

<h2>🎟 Bilet Satış Ekranı</h2>

<form asp-action="Sell" method="post">
    <div>
        <label>Yaş</label>
        <input asp-for="Age" type="number" required />
    </div>

    <div>
        <label>
            <input asp-for="IsTurkish" type="checkbox" />
            Türk Vatandaşı
        </label>
    </div>

    <div>
        <label>
            <input asp-for="IsTurkishSoldier" type="checkbox" />
            Asker
        </label>
    </div>

    <br />

    <button type="submit">🎟 Bilet Sat</button>
</form>

@if (Model != null && Model.Success == false)
{
    <hr />
    <p style="color:red">@Model.Message</p>
}