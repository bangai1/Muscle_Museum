@model Museum_App.DTOs.TicketResultDto
@using Museum_App.Helpers

<h2>Bilet Bilgileri</h2>

<hr />

<p>
    <strong>Bilet Türü:</strong>
    @TicketHelper.GetTicketDisplayName(Model.Ticket)
</p>

<p>
    <strong>Ücret:</strong>
    @Model.Price ₺
</p>



@if (Model.Price == 0)
{
    <p style="color: green;">
        Ücretsiz Bilet
    </p>
}
else
{
    <p style="color: blue;">
        Ücretli Bilet
    </p>
}
